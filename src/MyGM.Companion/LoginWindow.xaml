<Window x:Class="MyGM.Companion.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MyGM Companion · Anmeldung" Width="520" Height="610" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#080A0F" Foreground="White">
 <Grid Margin="34"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel HorizontalAlignment="Center"><Image Source="assets/mygm.ico" Height="120"/><TextBlock Text="MYGM COMPANION" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="DEIN GM. DEINE CARD. JEDE WOCHE." Foreground="#A7ABB8" HorizontalAlignment="Center" Margin="0,5,0,24"/></StackPanel>
  <Border Grid.Row="1" Background="#171922" CornerRadius="12" Padding="24"><StackPanel><TextBlock Text="BENUTZERNAME" Foreground="#A7ABB8"/><TextBox x:Name="UsernameInput" Height="42" Padding="10" Margin="0,5,0,14"/><TextBlock Text="PASSWORT" Foreground="#A7ABB8"/><PasswordBox x:Name="PasswordInput" Height="42" Padding="10" Margin="0,5,0,14" Background="#0A0D14" Foreground="White" BorderBrush="#343947"/><TextBlock Text="LIZENZCODE" Foreground="#A7ABB8"/><TextBox x:Name="LicenseInput" Height="42" Padding="10" Margin="0,5,0,18"/><Button x:Name="LoginButton" Content="ANMELDEN &amp; STARTEN" Height="48" Click="Login_Click"/><TextBlock x:Name="LoginStatus" Foreground="#FFB45A" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
  <TextBlock Grid.Row="2" Text="Die Lizenz wird serverseitig geprüft. Bei einer Störung kann eine zuletzt bestätigte Lizenz maximal 72 Stunden offline weiterlaufen." Foreground="#777F91" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Bottom" Margin="12"/>
 </Grid>
</Window>
