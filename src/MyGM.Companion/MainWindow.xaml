<Window x:Class="MyGM.Companion.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WWE 2K26 MyGM Companion V11.4.0" Height="760" Width="1180" MinHeight="650" MinWidth="940" Background="#080A0F" Foreground="White" WindowStartupLocation="CenterScreen">
 <Grid><Grid.Background><RadialGradientBrush Center="0.12,0.05" GradientOrigin="0.12,0.05" RadiusX="1.1" RadiusY="1.1"><GradientStop Color="#321016" Offset="0"/><GradientStop Color="#10131B" Offset="0.42"/><GradientStop Color="#07090E" Offset="1"/></RadialGradientBrush></Grid.Background><Border Height="4" VerticalAlignment="Top"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#E31B23"/><GradientStop Color="#FFFFFF" Offset="0.5"/><GradientStop Color="#2875FF" Offset="1"/></LinearGradientBrush></Border.Background></Border>
 <Grid Margin="24,20,24,24"><Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <StackPanel Grid.Column="0"><Border Background="#B40B0E15" BorderBrush="#3F4657" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,18"><StackPanel><Image Source="assets/mygm.ico" Height="112" Stretch="Uniform"/><TextBlock Text="COMPANION 11.4.0" HorizontalAlignment="Center" FontSize="15" FontWeight="Bold" Margin="0,3,0,0"/><TextBlock Text="BOOK. BUILD. DOMINATE." HorizontalAlignment="Center" FontSize="10" Foreground="#AEB5C5" Margin="0,3,0,0"/></StackPanel></Border>
   <Button Content="DIAGNOSE" HorizontalContentAlignment="Left" Click="Diagnostics_Click"/><Button Content="DASHBOARD" HorizontalContentAlignment="Left" Click="Dashboard_Click"/><Button Content="ROSTER &amp; BRAND" HorizontalContentAlignment="Left" Click="Roster_Click"/><Button Content="ZIELE &amp; VERSPRECHEN" HorizontalContentAlignment="Left" Click="Objectives_Click"/><Button Content="SHOW-PLANUNG" HorizontalContentAlignment="Left" Click="Planning_Click"/><Button Content="ANALYSE &amp; LERNEN" HorizontalContentAlignment="Left" Click="Analysis_Click"/><Button x:Name="UpdatesButton" Content="UPDATES · PRÜFE …" HorizontalContentAlignment="Left" Background="#273144" BorderBrush="#4A5A75" Click="Updates_Click" ToolTip="GitHub-Release wird geprüft"/>
   <Border Background="#171922" CornerRadius="8" Padding="14" Margin="0,24,0,0"><StackPanel><TextBlock Text="Overlay" FontWeight="Bold"/><TextBlock x:Name="OverlayState" Text="Aus · INSERT" Foreground="#A7ABB8" Margin="0,4,0,8"/><Button Content="Umschalten" Click="Overlay_Click"/></StackPanel></Border>
  </StackPanel>
  <Grid Grid.Column="2"><Grid x:Name="DiagnosticsPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="Stabilitätsdiagnose" FontSize="28" FontWeight="Bold"/><TextBlock Grid.Row="1" Text="Testet nur Fenstererkennung und einen gezielten Screenshot. Keine OCR, kein Polling, kein Hook." Foreground="#A7ABB8" Margin="0,8,0,20"/>
    <Border Grid.Row="2" Background="#171922" CornerRadius="10" Padding="22"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal"><Button Content="WWE-FENSTER SUCHEN" Click="Find_Click"/><Button Content="SCREENSHOT TESTEN" Click="Capture_Click"/><Button Content="ABBRECHEN" Background="#353946" Click="Cancel_Click"/></StackPanel>
      <Grid Grid.Row="1" Margin="0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Status" Foreground="#A7ABB8"/><TextBlock x:Name="StatusText" Text="Bereit" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="DetailsText" Text="Noch kein Test ausgeführt" TextWrapping="Wrap" Margin="0,8,20,0" Foreground="#A7ABB8"/></StackPanel><Border Grid.Column="1" BorderBrush="#353946" BorderThickness="1" MinHeight="280"><Image x:Name="PreviewImage" Stretch="Uniform"/></Border></Grid>
      <TextBox Grid.Row="2" x:Name="LogText" Background="#0D0F15" Foreground="#BFC4D1" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Padding="12"/>
    </Grid></Border>
  </Grid>
  <Grid x:Name="DashboardPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Dashboard" FontSize="28" FontWeight="Bold"/><UniformGrid Grid.Row="1" Columns="2" Margin="0,22,0,0">
    <Border Background="#171922" CornerRadius="10" Padding="22" Margin="0,0,10,0"><StackPanel><TextBlock Text="DIAGNOSESTATUS" Foreground="#A7ABB8"/><TextBlock x:Name="DashboardDiagnostic" Text="Noch nicht bestanden" FontSize="22" FontWeight="Bold" Margin="0,8"/><TextBlock Text="Automatische Erkennung und OCR bleiben bis zu einem erfolgreichen Capture gesperrt." Foreground="#A7ABB8" TextWrapping="Wrap"/><TextBlock x:Name="DashboardObjectives" Text="Keine bestätigten Ziele" Foreground="#A7ABB8" Margin="0,14,0,0" TextWrapping="Wrap"/></StackPanel></Border>
    <Border Background="#171922" CornerRadius="10" Padding="22" Margin="10,0,0,0"><StackPanel><TextBlock Text="AKTUELLE SHOW" Foreground="#A7ABB8"/><TextBlock x:Name="DashboardShow" Text="Noch keine Show gespeichert" FontSize="22" FontWeight="Bold" Margin="0,8"/><TextBlock x:Name="DashboardBudget" Foreground="#A7ABB8"/><TextBlock x:Name="DashboardLearning" Text="Noch keine Lerndaten" Foreground="#A7ABB8" Margin="0,14,0,0" TextWrapping="Wrap"/></StackPanel></Border>
  </UniformGrid></Grid>
  <Grid x:Name="PlanningPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Automatische Show-Empfehlung" FontSize="28" FontWeight="Bold"/><TextBlock Grid.Row="1" Text="Verwendet den aktiven Spielstand, dessen Showplätze, Ziele, Ausdauer, Manager und bisherige Ergebnisse." Foreground="#A7ABB8" Margin="0,8,0,18"/>
    <Border Grid.Row="2" Background="#171922" CornerRadius="10" Padding="22"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Show / Woche" Foreground="#A7ABB8"/><TextBox x:Name="ShowNameInput" Text="Show 1" Margin="0,5,0,14" Padding="10"/><TextBlock Text="Verfügbares Budget" Foreground="#A7ABB8"/><TextBox x:Name="BudgetInput" Text="0" Margin="0,5,0,14" Padding="10"/><TextBlock Text="Commissioner-Ziel" Foreground="#A7ABB8"/><TextBox x:Name="GoalInput" Margin="0,5,0,14" Padding="10"/><TextBlock Text="Roster / Notizen" Foreground="#A7ABB8"/><TextBox x:Name="RosterInput" Height="130" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,5,0,0" Padding="10"/></StackPanel>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="DEINE EMPFOHLENE CARD" Foreground="#EF4348" FontWeight="Bold"/><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"><StackPanel x:Name="RecommendationCards"/></ScrollViewer><TextBox x:Name="CardInput" Visibility="Collapsed" AcceptsReturn="True"/></Grid></Grid></Border>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0"><Button Content="BESTE CARD BERECHNEN" Click="AutoPlan_Click"/><Button Content="EMPFEHLUNG MERKEN" Background="#353946" Click="SavePlan_Click"/><TextBlock x:Name="PlanSaveStatus" VerticalAlignment="Center" Foreground="#A7ABB8" Margin="10,0,0,8"/></StackPanel>
  </Grid>
  <Grid x:Name="RosterPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Roster &amp; Brand" FontSize="28" FontWeight="Bold"/><TextBlock Grid.Row="1" Text="Einmaliger Screenshot und OCR nur auf Knopfdruck. Bitte erkannte Werte vor dem Speichern kontrollieren." Foreground="#A7ABB8" Margin="0,8,0,16"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal"><StackPanel Width="190"><TextBlock Text="Aktueller Spielstand" Foreground="#A7ABB8"/><TextBox x:Name="CareerNameInput" Text="Neuer Spielstand" Margin="0,5,12,12" Padding="9"/></StackPanel><StackPanel Width="130"><TextBlock Text="Brand" Foreground="#A7ABB8"/><TextBox x:Name="BrandInput" Margin="0,5,12,12" Padding="9"/></StackPanel><StackPanel Width="90"><TextBlock Text="Woche" Foreground="#A7ABB8"/><TextBox x:Name="WeekInput" Text="1" Margin="0,5,12,12" Padding="9"/></StackPanel><Button Content="AKTUELLES ROSTER SCANNEN" VerticalAlignment="Bottom" Click="RosterCapture_Click"/><Button Content="ECW-SCAN ÜBERNEHMEN" VerticalAlignment="Bottom" Click="UseCurrentEcw_Click"/><Button Content="ABBRECHEN" Background="#353946" VerticalAlignment="Bottom" Click="Cancel_Click"/></StackPanel>
    <Border Grid.Row="3" Background="#171922" CornerRadius="10" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Name | Geschlecht (M/W) | Rolle | Klasse | POP | Ausdauer | Manager | Rivalität (0–4)" Foreground="#A7ABB8"/><TextBox Grid.Row="1" x:Name="RosterEditor" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="0,10,0,0" Padding="10"/></Grid></Border>
    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,14,0,0"><Button Content="SCAN BESTÄTIGEN" Click="SaveRoster_Click"/><TextBlock x:Name="RosterStatus" VerticalAlignment="Center" Foreground="#A7ABB8" Margin="10,0,0,8" TextWrapping="Wrap"/></StackPanel>
  </Grid>
  <Grid x:Name="ObjectivesPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Ziele &amp; Versprechen" FontSize="28" FontWeight="Bold"/><TextBlock Grid.Row="1" Text="Commissioner-Ziele und Superstar-Versprechen gezielt erfassen, prüfen und priorisieren." Foreground="#A7ABB8" Margin="0,8,0,16"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal"><Button Content="ZIELSEITE ERFASSEN" Click="ObjectivesCapture_Click"/><Button Content="TEXT NEU AUSWERTEN" Background="#353946" Click="ReparseObjectives_Click"/><Button Content="ABBRECHEN" Background="#353946" Click="Cancel_Click"/><TextBlock x:Name="ObjectivesStatus" VerticalAlignment="Center" Foreground="#A7ABB8" Margin="10,0,0,8"/></StackPanel>
    <Border Grid.Row="3" Background="#171922" CornerRadius="10" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="AKTIVE ZIELE UND VERSPRECHEN" Foreground="#EF4348" FontWeight="Bold"/><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"><StackPanel x:Name="ObjectiveCards"/></ScrollViewer><Expander Grid.Row="2" Header="Erkennungsdetails anzeigen" Foreground="#A7ABB8" Margin="0,10,0,0"><Grid Height="150"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="ObjectivesRaw" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8"/><TextBox Grid.Column="2" x:Name="ObjectivesEditor" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Padding="8"/></Grid></Expander></Grid></Border>
    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,14,0,0"><Button Content="BESTÄTIGTE ZIELE SPEICHERN" Click="SaveObjectives_Click"/><TextBlock Text="Hoch = nach Möglichkeit zwingend · Mittel = gegen Showqualität abwägen" Foreground="#A7ABB8" VerticalAlignment="Center" Margin="10,0,0,8"/></StackPanel>
  </Grid>
  <Grid x:Name="AnalysisPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Showanalyse &amp; lokales Lernen" FontSize="28" FontWeight="Bold"/><TextBlock Grid.Row="1" Text="Ergebnisse einmalig erfassen, bestätigen und als Lernbasis für kommende Auto-Pläne speichern." Foreground="#A7ABB8" Margin="0,8,0,14"/>
   <StackPanel Grid.Row="2" Orientation="Horizontal"><Button Content="ERGEBNISSE ERFASSEN" Click="ResultsCapture_Click"/><Button Content="ANALYSIEREN &amp; LERNEN" Click="AnalyzeResults_Click"/><Button Content="ABBRECHEN" Background="#353946" Click="Cancel_Click"/><TextBlock x:Name="AnalysisStatus" Foreground="#A7ABB8" VerticalAlignment="Center" Margin="10,0,0,8"/></StackPanel>
   <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#171922" CornerRadius="10" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="120"/></Grid.RowDefinitions><TextBlock Text="OCR-Originaltext (nur Referenz)" Foreground="#A7ABB8"/><TextBox Grid.Row="1" x:Name="ResultsRaw" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,7,0,10" Padding="8"/><TextBlock Grid.Row="2" Text="Notizen / Endwertung" Foreground="#A7ABB8"/><Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBox x:Name="ResultsNotes" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,7,8,0" Padding="8"/><TextBox Grid.Column="1" x:Name="EndRatingInput" Text="0" Margin="0,7,0,0" Padding="8" ToolTip="Endwertung 0–5"/></Grid></Grid></Border>
    <Border Grid.Column="2" Background="#171922" CornerRadius="10" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/><RowDefinition Height="100"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Matches: A vs B | Matchtyp | Sterne" Foreground="#A7ABB8"/><TextBox Grid.Row="1" x:Name="MatchResultsEditor" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" Margin="0,7,0,10" Padding="8"/><TextBlock Grid.Row="2" Text="Promos: Name | Promotyp | Wert 0–5" Foreground="#A7ABB8"/><TextBox Grid.Row="3" x:Name="PromoResultsEditor" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" Margin="0,7,0,10" Padding="8"/><TextBlock Grid.Row="4" Text="Lernbericht" Foreground="#A7ABB8"/><TextBox Grid.Row="5" x:Name="LearningReportText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,7,0,0" Padding="8"/></Grid></Border></Grid>
  </Grid>
  </Grid></Grid></Grid>
</Window>
